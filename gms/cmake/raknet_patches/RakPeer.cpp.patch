namespace RakNet {
// ---- Dawngate restoration (gms/cmake/raknet_patches/RakPeer.cpp.patch): handshake hardening ----
void RakPeer::DgSetHardening(const DgHardening &h)
{
	dgHardening=h;
}
RakPeer::DgHardening RakPeer::DgGetHardening(void) const
{
	return dgHardening;
}
RakPeer::DgCounts RakPeer::DgTakeCounts(void)
{
	DgCounts c;
	c.request1Short=dgRequest1Short.exchange(0);
	c.request2BadCookie=dgRequest2BadCookie.exchange(0);
	c.nonsenseClosed=dgNonsenseClosed.exchange(0);
	c.nonsenseBanned=dgNonsenseBanned.exchange(0);
	c.orderedAheadClosed=dgOrderedAheadClosed.exchange(0);
	c.cookiesIssued=dgCookiesIssued.exchange(0);
	return c;
}
static uint64_t DgRotl(uint64_t x, int b)
{
	return (x << b) | (x >> (64 - b));
}
// SipHash-2-4 of m (a 128-bit key, a 64-bit tag), from the public specification
static uint64_t DgSipHash24(const unsigned char k[16], const unsigned char *m, size_t len)
{
	uint64_t k0=0, k1=0;
	for (int i=0; i < 8; i++)
	{
		k0|=(uint64_t)k[i] << (8*i);
		k1|=(uint64_t)k[8+i] << (8*i);
	}
	uint64_t v0=0x736f6d6570736575ULL^k0, v1=0x646f72616e646f6dULL^k1, v2=0x6c7967656e657261ULL^k0, v3=0x7465646279746573ULL^k1;
#define DG_SIPROUND do { v0+=v1; v1=DgRotl(v1,13); v1^=v0; v0=DgRotl(v0,32); v2+=v3; v3=DgRotl(v3,16); v3^=v2; \
	v0+=v3; v3=DgRotl(v3,21); v3^=v0; v2+=v1; v1=DgRotl(v1,17); v1^=v2; v2=DgRotl(v2,32); } while (0)
	size_t i=0;
	for (; i+8 <= len; i+=8)
	{
		uint64_t mi=0;
		for (int j=0; j < 8; j++)
			mi|=(uint64_t)m[i+j] << (8*j);
		v3^=mi;
		DG_SIPROUND;
		DG_SIPROUND;
		v0^=mi;
	}
	uint64_t b=((uint64_t)len) << 56;
	for (size_t j=0; i+j < len; j++)
		b|=(uint64_t)m[i+j] << (8*j);
	v3^=b;
	DG_SIPROUND;
	DG_SIPROUND;
	v0^=b;
	v2^=0xff;
	DG_SIPROUND;
	DG_SIPROUND;
	DG_SIPROUND;
	DG_SIPROUND;
#undef DG_SIPROUND
	return v0^v1^v2^v3;
}
// The cookie for a sender's IPv4 address and port in one 10-s period; REQUEST_2 may echo this period's or the last's
static uint32_t DgCookie(const RakPeer *rakPeer, const SystemAddress &sa, uint32_t period)
{
	unsigned char m[10];
	memcpy(m, &sa.address.addr4.sin_addr.s_addr, 4);
	memcpy(m+4, &sa.address.addr4.sin_port, 2);
	m[6]=(unsigned char)period;
	m[7]=(unsigned char)(period >> 8);
	m[8]=(unsigned char)(period >> 16);
	m[9]=(unsigned char)(period >> 24);
	return (uint32_t)DgSipHash24(rakPeer->dgHardening.cookieKey, m, sizeof(m));
}
static uint32_t DgCookiePeriod(void)
{
	return (uint32_t)(RakNet::GetTimeMS() / 10000);
}
static bool DgCookieValid(const RakPeer *rakPeer, const SystemAddress &sa, uint32_t cookie)
{
	const uint32_t p=DgCookiePeriod();
	return cookie==DgCookie(rakPeer, sa, p) || cookie==DgCookie(rakPeer, sa, p-1);
}
// REQUEST_1 is answered only when it is at least as long as REPLY_1 (with the cookie) and the incompatible-version
// reply: a spoofed request gains nothing by reflection. The real client pads it to its MTU probe (548 bytes or more).
static bool DgRequest1Acceptable(RakPeer *rakPeer, int length)
{
	if (rakPeer->dgHardening.request1NoSmallerThanReply==false)
		return true;
	const int reply=(int)(sizeof(MessageID)+sizeof(OFFLINE_MESSAGE_DATA_ID)+RakNetGUID::size()+1+(rakPeer->dgHardening.handshakeCookies ? 4 : 0)+2);
	if (length >= reply)
		return true;
	rakPeer->dgRequest1Short++;
	return false;
}
